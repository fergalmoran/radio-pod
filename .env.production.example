# Copy to .env.production on the server and fill in real values.

# ── App ──────────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://surge.fm

# ── Database ──────────────────────────────────────────────────────────────────────
DB_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@db:5432/radio-pod

# ── kacl (playout automation, encoding, and streaming — replaces Liquidsoap/Icecast) ─
KACL_URL=http://kacl:8080
# Also doubles as the access token for kacl's PlayoutHub SignalR connection.
KACL_CONTROL_API_KEY=change-me

# ── Stream ────────────────────────────────────────────────────────────────────────
# URL the browser uses to reach kacl's live MP3 stream.
# In production this is usually proxied via nginx on the same domain.
VITE_STREAM_URL=https://stream.surge.fm/stream/mp3

# ── Live video (OBS -> MediaMTX) ────────────────────────────────────────────────────
# Shared secret MediaMTX uses to authenticate its webhook calls back into the app.
MEDIAMTX_WEBHOOK_SECRET=change-me-generate-with-openssl-rand-base64-32
# RTMP URL shown to hosts to paste into OBS. Port 1935 is raw TCP — needs an nginx
# stream{} block (not a normal location proxy) to be reachable publicly.
MEDIAMTX_RTMP_PUBLIC_URL=rtmp://stream.surge.fm:1935
# HLS playback URL the browser uses to watch a live stream.
MEDIAMTX_HLS_PUBLIC_URL=https://live.surge.fm

# ── OAuth (optional) ─────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Media directories (host paths, mounted into containers) ───────────────────────
# Leave blank to use the defaults under /opt/surge-fm/media/
MEDIA_SHOWS=/opt/surge-fm/media/shows
MEDIA_IMAGES=/opt/surge-fm/media/images
MEDIA_DEADAIR=/opt/surge-fm/media/deadair
MEDIA_JINGLES=/opt/surge-fm/media/jingles
